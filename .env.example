# Copy to .env (git-ignored). Used by docker-compose.yml (dev profile). Placeholders only; never commit real keys.
POSTGRES_PORT=5432
BACKEND_PORT=8090
POSTGRES_PASSWORD=bitadilat
# Craftgate sandbox keys. Left empty, compose passes a placeholder: the backend starts and everything
# works except the card payment step, which returns a gateway error.
CRAFTGATE_API_KEY=
CRAFTGATE_SECRET_KEY=
CRAFTGATE_CALLBACK_KEY=
# Prod (SPRING_PROFILES_ACTIVE=prod) is not run with this compose file. Its variables (DB_URL, JWT_SECRET,
# ADDRESS_KEY, MEDIA_SIGNING_KEY, MEDIA_DIR, APP_PUBLIC_BASE_URL, BITADILAT_CORS_ORIGINS,
# CRAFTGATE_CALLBACK_KEY, SPRING_MAIL_HOST, BITADILAT_MAIL_FROM, BITADILAT_ADMIN_EMAIL, ...) are listed
# in docs/spec/PROD_CONFIG.md.
