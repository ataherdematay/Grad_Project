                  "    if (pidMatch) pm.collectionVariables.set('craftgatePaymentId', pidMatch[1]);",
                  "    if (cidMatch) pm.collectionVariables.set('conversationId', cidMatch[1]);",
                  "    pm.visualizer.set(html);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"{{offerId}}\",\n  \"attemptKey\": \"{{$guid}}\",\n  \"cardHolderName\": \"Ali Yılmaz\",\n  \"cardNumber\": \"5258640000000001\",\n  \"expireMonth\": \"07\",\n  \"expireYear\": \"2044\",\n  \"cvc\": \"000\"\n}"
            },
            "url": {
