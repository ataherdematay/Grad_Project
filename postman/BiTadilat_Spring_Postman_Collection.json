    {
      "name": "0A. Craftgate 3D Secure & Güvence Havuzu (Doğrudan Ödeme Akışı)",
      "item": [
        {
          "name": "Adım 1: Teklif Özeti Getir (GET /api/offers/OFFER-BD-88412)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/offers/OFFER-BD-88412",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offers", "OFFER-BD-88412"]
            }
          }
        },
        {
          "name": "Adım 2: Craftgate 3D Secure Ödeme Başlat (POST /api/payments/3ds/init)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('paymentRef', res.ref);",
                  "    const html = res.htmlContent || '';",
                  "    const pidMatch = html.match(/name=\"paymentId\"\\s+value=\"([^\"]+)\"/);",
                  "    const cidMatch = html.match(/name=\"conversationId\"\\s+value=\"([^\"]+)\"/);",
                  "    if (pidMatch) pm.collectionVariables.set('craftgatePaymentId', pidMatch[1]);",
                  "    if (cidMatch) pm.collectionVariables.set('conversationId', cidMatch[1]);",
                  "    pm.visualizer.set(html);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"OFFER-BD-88412\",\n  \"attemptKey\": \"{{$guid}}\",\n  \"cardHolderName\": \"Hakan Kuvan\",\n  \"cardNumber\": \"5258640000000001\",\n  \"expireMonth\": \"07\",\n  \"expireYear\": \"2044\",\n  \"cvc\": \"000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/3ds/init",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "3ds", "init"]
            }
          }
        },
