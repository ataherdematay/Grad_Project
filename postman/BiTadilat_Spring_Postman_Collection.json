        {
          "name": "2. Açık Talebi ve Teklif ID'sini Otomatik Al (GET /api/v1/requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    const items = res.items || [];",
                  "    const openReq = items.find(r => r.status === 'OPEN') || items[0];",
                  "    if (openReq) {",
                  "        pm.sendRequest({",
                  "            url: pm.collectionVariables.get('baseUrl') + '/api/v1/requests/' + openReq.id + '/offers',",
                  "            method: 'GET',",
                  "            header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken') }",
                  "        }, function (err, offerRes) {",
                  "            if (!err && offerRes.code === 200) {",
                  "                const offers = offerRes.json().items || [];",
                  "                const pending = offers.find(o => o.status === 'PENDING') || offers[0];",
                  "                if (pending) pm.collectionVariables.set('offerId', pending.id);",
                  "            }",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests?scope=active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "requests"],
              "query": [
                {
                  "key": "scope",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "3. v1 Craftgate 3DS Ödeme Başlat (POST /api/v1/payments/3ds/init)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
