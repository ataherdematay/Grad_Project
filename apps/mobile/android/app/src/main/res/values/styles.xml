<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Surec baslarken gosterilen tema (Android 11 ve alti: windowBackground,
         Android 12+: values-v31 icindeki SplashScreen oznitelikleri). Ilk Flutter
         karesi cizilince MainActivity NormalTheme'e gecer. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter arayuzu acilirken ve arkasinda kullanilan tema. Arka plan launch ile
         ayni canvas rengidir, bu yuzden beyaz parlama olmaz. Uygulama yalnizca acik temalidir. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/bitadilat_canvas</item>
    </style>
</resources>
